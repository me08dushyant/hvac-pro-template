---
// Numbered row with a title, a line of copy, and a trailing arrow — the
// "six disciplines" list on Home and the open-roles list on Careers.
// Pass `meta` (e.g. location/experience) to stack the title+desc in one
// column and add mono columns for each meta value, as Careers does.
interface Props {
  no: string;
  title: string;
  desc: string;
  meta?: string[];
  href: string;
  class?: string;
}

const { no, title, desc, meta, href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['row', meta ? 'row--meta' : 'row--plain', className]}
  style={meta ? `--meta-cols:${meta.length}` : undefined}
  data-reveal-item
>
  <span class="row-no">{no}</span>
  {meta ? (
    <span class="row-stack">
      <span class="row-title">{title}</span>
      <span class="row-desc row-desc--stacked">{desc}</span>
    </span>
  ) : (
    <>
      <span class="row-title">{title}</span>
      <span class="row-desc">{desc}</span>
    </>
  )}
  {meta && meta.map((m) => <span class="row-meta-col">{m}</span>)}
  <span class="row-arrow">→</span>
</a>

<style>
  .row {
    display: grid;
    align-items: center;
    gap: 24px;
    padding: 28px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--ink);
    transition: background-color 0.3s ease;
  }

  .row:hover {
    background: var(--bg-alt);
    color: var(--ink);
  }

  .row--plain {
    grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 1.4fr) 32px;
  }

  .row--meta {
    grid-template-columns: 56px minmax(0, 1.3fr) repeat(var(--meta-cols), minmax(0, 0.8fr)) 32px;
  }

  .row-no {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .row-title {
    font-family: var(--font-display);
    font-size: clamp(19px, 2.4vw, 27px);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .row-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .row-desc {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body-2);
  }

  .row-desc--stacked {
    font-size: 15px;
  }

  .row-meta-col {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .row-arrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--blue);
    text-align: right;
    transition: transform 0.3s ease;
  }

  .row:hover .row-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 780px) {
    .row--plain,
    .row--meta {
      grid-template-columns: 40px 1fr;
    }
    .row-meta-col,
    .row-arrow {
      display: none;
    }
    .row--plain .row-desc {
      grid-column: 1 / -1;
    }
  }
</style>
