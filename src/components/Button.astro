---
// Shared CTA button/link. One component, every variant the design system uses.
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'outline' | 'outline-invert' | 'invert' | 'primary-on-dark';
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
}

const { href, variant = 'primary', type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', `btn--${variant}`, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 15px 28px;
    border-radius: 2px;
    border: none;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .btn--primary {
    background: var(--blue);
    color: #fff;
  }
  .btn--primary:hover {
    background: var(--ink);
    color: #fff;
  }

  .btn--accent {
    background: var(--red);
    color: #fff;
  }
  .btn--accent:hover {
    background: var(--ink);
    color: #fff;
  }

  .btn--outline {
    background: none;
    color: var(--ink);
    border: 1px solid var(--input-border);
  }
  .btn--outline:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .btn--outline-invert {
    background: none;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
  }
  .btn--outline-invert:hover {
    border-color: #fff;
    color: #fff;
  }

  .btn--invert {
    background: #fff;
    color: var(--blue);
  }
  .btn--invert:hover {
    background: var(--ink);
    color: #fff;
  }

  .btn--primary-on-dark {
    background: var(--blue);
    color: #fff;
  }
  .btn--primary-on-dark:hover {
    background: #fff;
    color: var(--blue);
  }
</style>
