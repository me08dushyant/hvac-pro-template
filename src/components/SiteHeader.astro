---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import { NAV_LINKS, COMPANY } from '../data/nav.js';

const currentPath = Astro.url.pathname;
const phoneHref = `tel:${COMPANY.hq.phone.replace(/[^\d+]/g, '')}`;
const emergency = COMPANY.hours.find((h) => h.accent);
---

<div class="topbar">
  <div class="wrap topbar-row">
    <div class="topbar-contacts">
      <a href={phoneHref} class="topbar-link">
        <Icon name="lucide:phone" />
        {COMPANY.hq.phone}
      </a>
      <a href={`mailto:${COMPANY.hq.email}`} class="topbar-link topbar-link--email">
        <Icon name="lucide:mail" />
        {COMPANY.hq.email}
      </a>
      {emergency && (
        <span class="topbar-emergency">
          <Icon name="lucide:clock" />
          Emergency line · {emergency.value}
        </span>
      )}
    </div>
    <a href={`mailto:${COMPANY.hq.email}`} class="topbar-email-icon" aria-label={`Email ${COMPANY.hq.email}`}>
      <Icon name="lucide:mail" />
    </a>
    <div class="topbar-region">
      <Icon name="lucide:map-pin" />
      {COMPANY.regions}
    </div>
  </div>
</div>

<header class="site-header">
  <div class="wrap header-row">
    <a href="/" class="logo">
      <span class="logo-mark">{COMPANY.name}</span>
      <span class="logo-est">{COMPANY.founded}</span>
    </a>

    <nav class="nav" id="site-nav">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >
          <span class="link-flip" aria-hidden="true">
            <span class="link-flip-row link-flip-row--top">{link.label}</span>
            <span class="link-flip-row link-flip-row--bottom">{link.label}</span>
          </span>
          <span class="sr-only">{link.label}</span>
        </a>
      ))}
      <div class="nav-cta">
        <Button href="/contact" variant="accent" class="nav-cta-btn">Request a quote</Button>
      </div>
    </nav>

    <div class="actions">
      <a href="/certifications" class="compliance-link">COMPLIANCE →</a>
      <Button href="/contact" variant="accent" class="header-cta">Request a quote</Button>
      <button
        type="button"
        class="menu-btn"
        id="menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="hamburger" aria-hidden="true">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  import { gsap, reduceMotion, initLinkFlip } from '../scripts/motion.js';

  // Per-letter "swap up" hover on the desktop nav links (see initLinkFlip
  // in motion.js — shared with the footer link columns).
  initLinkFlip('.nav-link');

  const menuToggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');
  const [topLine, midLine, bottomLine] = menuToggle
    ? Array.from(menuToggle.querySelectorAll<HTMLElement>('.hamburger-line'))
    : [];
  const dur = reduceMotion ? 0 : 0.35;

  // The dropdown used to animate its own height (0 -> measured full height).
  // That leaves the panel's box genuinely small for most of the tween, and
  // since it's still a flex column with the base `.nav` rule's `flex-wrap:
  // wrap` in effect, a short intermediate height made the links wrap
  // sideways into a row instead of staying stacked — a visible reflow/flick
  // on every open and close. The panel never needs to change size: it's an
  // absolutely-positioned overlay (see `.nav` below), so nothing in the
  // page flow depends on its height. Keep it permanently at full natural
  // height and animate position + opacity instead (slide + fade), which
  // can't trigger a wrap. Scoped to the mobile breakpoint with
  // gsap.matchMedia() so the desktop horizontal nav is never touched, and
  // so resizing past 860px while the menu is open cleanly reverts it.
  const mm = gsap.matchMedia();
  mm.add('(max-width: 860px)', () => {
    if (!nav) return;
    gsap.set(nav, { y: -12, autoAlpha: 0 });
    return () => {
      nav.classList.remove('nav--open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    };
  });

  function openNav() {
    if (!nav) return;
    gsap.to(nav, { y: 0, autoAlpha: 1, duration: dur, ease: 'power2.out', overwrite: true });
  }

  function closeNav() {
    if (!nav) return;
    gsap.to(nav, { y: -12, autoAlpha: 0, duration: dur, ease: 'power2.in', overwrite: true });
  }

  menuToggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('nav--open');
    nav?.classList.toggle('nav--open', open);
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    open ? openNav() : closeNav();

    if (topLine && midLine && bottomLine) {
      if (open) {
        gsap.to(topLine, { y: 7, rotation: 45, duration: dur, ease: 'power2.inOut' });
        gsap.to(midLine, { autoAlpha: 0, duration: dur * 0.6, ease: 'power2.inOut' });
        gsap.to(bottomLine, { y: -7, rotation: -45, duration: dur, ease: 'power2.inOut' });
      } else {
        gsap.to(topLine, { y: 0, rotation: 0, duration: dur, ease: 'power2.inOut' });
        gsap.to(midLine, { autoAlpha: 1, duration: dur * 0.7, delay: dur * 0.3, ease: 'power2.inOut' });
        gsap.to(bottomLine, { y: 0, rotation: 0, duration: dur, ease: 'power2.inOut' });
      }
    }
  });
</script>

<style>
  .topbar {
    position: relative;
    z-index: 60;
    background: var(--ink);
    color: var(--text-ticker);
    font-family: var(--font-mono);
    font-size: 12px;
    overflow: hidden;
  }

  .topbar-row {
    padding-block: 9px;
    display: flex;
    align-items: center;
    gap: 28px;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .topbar-row::-webkit-scrollbar {
    display: none;
  }

  .topbar-contacts {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .topbar-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #fff;
  }

  .topbar-link:hover {
    color: var(--blue);
  }

  .topbar-link :global(svg) {
    width: 13px;
    height: 13px;
    opacity: 0.75;
    flex-shrink: 0;
  }

  .topbar-emergency {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-ticker);
  }

  .topbar-emergency :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--blue);
    flex-shrink: 0;
  }

  .topbar-email-icon {
    display: none;
    align-items: center;
    margin-left: auto;
    color: #fff;
    flex-shrink: 0;
  }

  .topbar-email-icon:hover {
    color: var(--blue);
  }

  .topbar-email-icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .topbar-region {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
  }

  .topbar-region :global(svg) {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .topbar-emergency {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .topbar-link--email {
      display: none;
    }

    .topbar-email-icon {
      display: inline-flex;
    }
  }

  @media (max-width: 460px) {
    .topbar-region {
      display: none;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(245, 246, 248, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-row {
    padding-block: 18px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
    color: var(--ink);
  }

  .logo:hover {
    color: var(--blue);
  }

  .logo-mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.04em;
  }

  .logo-est {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
    margin-left: 12px;
    min-width: 0;
  }

  .nav a[aria-current='page'] {
    color: var(--blue);
  }

  .nav-link .link-flip-row--bottom {
    color: var(--blue);
  }

  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .compliance-link {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 13px;
    cursor: pointer;
    color: var(--ink);
  }

  .nav-cta {
    display: none;
  }

  .hamburger {
    position: relative;
    width: 22px;
    height: 16px;
  }

  .hamburger-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transform-origin: center;
  }

  .hamburger-line:nth-child(1) {
    top: 0;
  }

  .hamburger-line:nth-child(2) {
    top: 7px;
  }

  .hamburger-line:nth-child(3) {
    top: 14px;
  }

  @media (max-width: 980px) {
    .compliance-link {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      margin-left: 0;
      /* Stays at its natural full height always — position (y) and opacity
         are what's animated by GSAP (see script), never height/size. */
    }

    /* The GSAP module script that opens/closes this panel loads deferred,
       so without this rule the full nav (links + the "Request a quote"
       CTA) flashes open for a frame on every mobile load/nav before JS
       catches up and slides it away — the earlier "flick". Pre-hide it
       synchronously via CSS the moment js-motion lands (same FOUC fix used
       for [data-reveal] in global.css); a no-JS visit never gets this
       class, so the menu stays visible and usable. */
    html.js-motion .nav {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
    }

    .nav a {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
    }

    .nav-cta {
      display: block;
      padding: 20px;
    }

    :global(.nav-cta-btn) {
      width: 100%;
    }

    .site-header {
      position: sticky;
    }

    .header-row {
      position: relative;
    }

    .menu-btn {
      display: inline-flex;
    }

    :global(.actions .header-cta) {
      display: none !important;
    }
  }
</style>
