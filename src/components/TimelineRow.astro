---
interface Props {
  year: string;
  title: string;
  body: string;
  class?: string;
}

const { year, title, body, class: className } = Astro.props;
---

<div class:list={['tl', className]} data-reveal-item>
  <span class="tl-year">{year}</span>
  <span class="tl-title">{title}</span>
  <span class="tl-body">{body}</span>
</div>

<style>
  .tl {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 28px;
    align-items: baseline;
    padding: 26px 4px;
    border-bottom: 1px solid var(--border);
  }

  .tl-year {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--blue);
  }

  .tl-title {
    font-family: var(--font-display);
    font-size: clamp(19px, 2.2vw, 24px);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .tl-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-body-2);
  }

  @media (max-width: 700px) {
    .tl {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
