---
// Code / title / description row — the Certifications "dossier" list.
interface Props {
  code: string;
  title: string;
  body: string;
  class?: string;
}

const { code, title, body, class: className } = Astro.props;
---

<div class:list={['dr', className]} data-reveal-item>
  <span class="dr-code">{code}</span>
  <span class="dr-title">{title}</span>
  <span class="dr-body">{body}</span>
</div>

<style>
  .dr {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 28px;
    padding: 26px 0;
    border-bottom: 1px solid var(--panel-line-2);
    align-items: baseline;
  }

  .dr-code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--red);
  }

  .dr-title {
    font-family: var(--font-display);
    font-size: clamp(19px, 2.2vw, 23px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .dr-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-slate-2);
  }

  @media (max-width: 700px) {
    .dr {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
