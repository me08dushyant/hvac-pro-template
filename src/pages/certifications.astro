---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageMast from '../components/PageMast.astro';
import Kicker from '../components/Kicker.astro';
import CertCard from '../components/CertCard.astro';
import DossierRow from '../components/DossierRow.astro';
import { MARKS, DOSSIER, INSTRUMENTS } from '../data/certifications.js';
---

<BaseLayout
  title="Compliance"
  description="ISO 9001, ISO 14644-1, FDA cGMP, and EU GMP Annex 1 — with a dossier where every number traces to a calibrated instrument and a named engineer."
>
  <PageMast
    kicker="01 / COMPLIANCE"
    title="The standards, and the paperwork that proves them."
    sub="A logo on a website has never passed an inspection. What passes one is a dossier where every number traces to a calibrated instrument and a named engineer."
  />

  <section class="marks">
    <div class="wrap">
      <div class="marks-grid" data-reveal-group>
        {MARKS.map((m) => (
          <CertCard icon={m.icon} title={m.title} body={m.body} />
        ))}
      </div>
    </div>
  </section>

  <section class="dossier">
    <div class="wrap">
      <div data-reveal>
        <Kicker text="02 / THE DOSSIER" tone="dark" />
        <h2 class="dossier-title">Five documents, and none of them optional.</h2>
      </div>
      <div class="dossier-list" data-reveal-group>
        {DOSSIER.map((d) => (
          <DossierRow code={d.code} title={d.title} body={d.body} />
        ))}
      </div>
    </div>
  </section>

  <section class="instrumentation">
    <div class="wrap instrumentation-grid">
      <div>
        <Kicker text="03 / INSTRUMENTATION" tone="light" />
        <h2 class="instrumentation-title">Owned, calibrated, and operated by us.</h2>
        <p class="instrumentation-p">
          Testing is never subcontracted. Every instrument below is ours, calibrated annually against traceable
          standards, and operated by the validation engineer whose name goes on the report.
        </p>
      </div>
      <div class="instrument-grid">
        {INSTRUMENTS.map((i) => (
          <div class="instrument">{i}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="audit">
    <div class="wrap audit-row">
      <Kicker text="04 / AUDIT SUPPORT" tone="dark" />
      <p class="audit-copy">
        Our validation lead attends your regulatory inspection at no extra cost for the first twelve months after
        handover.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .marks {
    border-bottom: 1px solid var(--border);
    padding: 56px 0 76px;
  }

  .marks-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--grid-line);
    border: 1px solid var(--grid-line);
  }

  .dossier {
    border-bottom: 1px solid var(--border);
    background: var(--ink);
    color: #fff;
    padding: 76px 0 84px;
  }

  .dossier-title {
    margin: 24px 0 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 46px);
    line-height: 1.03;
    letter-spacing: -0.04em;
    max-width: 680px;
  }

  .dossier-list {
    border-top: 1px solid var(--panel-line-2);
  }

  .instrumentation {
    border-bottom: 1px solid var(--border);
    padding: 72px 0 84px;
  }

  .instrumentation-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }

  .instrumentation-title {
    margin: 24px 0 22px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 3.2vw, 38px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .instrumentation-p {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .instrument-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--grid-line);
    border: 1px solid var(--grid-line);
  }

  .instrument {
    background: var(--bg);
    padding: 22px;
    font-size: 16px;
    font-weight: 600;
  }

  .audit {
    border-bottom: 1px solid var(--border);
    background: var(--ink);
    color: #fff;
  }

  .audit-row {
    padding: 56px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 56px;
    align-items: center;
  }

  .audit-copy {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  @media (max-width: 900px) {
    .marks-grid {
      grid-template-columns: 1fr 1fr;
    }
    .instrumentation-grid,
    .audit-row {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 520px) {
    .marks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
