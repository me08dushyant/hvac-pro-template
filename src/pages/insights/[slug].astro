---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import Kicker from '../../components/Kicker.astro';
import Button from '../../components/Button.astro';
import InsightCard from '../../components/InsightCard.astro';
import { INSIGHTS, getInsight, getRelatedInsights, formatInsightDate } from '../../data/insights.js';

export function getStaticPaths() {
  return INSIGHTS.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getInsight(slug);
if (!post) {
  return Astro.redirect('/insights');
}

const related = getRelatedInsights(post, 3);
const [firstPara, ...restParas] = post.body;
---

<BaseLayout title={post.title} description={post.excerpt}>
  <section class="detail">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">HOME</a> / <a href="/insights">INSIGHTS</a> / <span class="crumb-current">{post.title.toUpperCase()}</span>
      </div>

      <div class="detail-grid">
        <div class="detail-copy" data-reveal-group>
          <Kicker text={`${post.category} · INSIGHTS`} tone="light" data-reveal-item />
          <h1 class="detail-title" data-reveal-item>{post.title}</h1>
          <p class="detail-intro" data-reveal-item>{post.intro}</p>
          <div class="fact-grid" data-reveal-item>
            <div class="fact">
              <div class="fact-label">PUBLISHED</div>
              <div class="fact-value">{formatInsightDate(post.date)}</div>
            </div>
            <div class="fact">
              <div class="fact-label">READ TIME</div>
              <div class="fact-value">{post.readTime}</div>
            </div>
            <div class="fact">
              <div class="fact-label">AUTHOR</div>
              <div class="fact-value">{post.author.name}</div>
            </div>
            <div class="fact">
              <div class="fact-label">CATEGORY</div>
              <div class="fact-value">{post.category}</div>
            </div>
          </div>
          <div class="detail-actions" data-reveal-item>
            <Button href="/contact" variant="primary">Talk to an engineer</Button>
            <Button href="/insights" variant="outline">Back to insights</Button>
          </div>
        </div>
        <div class="detail-visual" data-reveal>
          <ImagePlaceholder label={post.title} photo={post.photo} />
        </div>
      </div>
    </div>
  </section>

  <section class="article">
    <div class="wrap article-grid">
      <div class="article-body" data-reveal-group>
        <p class="article-p" data-reveal-item>{firstPara}</p>
        {post.quote && (
          <blockquote class="pull-quote" data-reveal-item>
            <p>{post.quote}</p>
          </blockquote>
        )}
        {restParas.map((para) => (
          <p class="article-p" data-reveal-item>{para}</p>
        ))}

        {post.takeaways?.length > 0 && (
          <div class="takeaways" data-reveal-item>
            <div class="takeaways-label">TAKEAWAYS</div>
            <ul class="takeaways-list">
              {post.takeaways.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        )}
      </div>

      <aside class="article-aside" data-reveal>
        <div class="author-card">
          <div class="author-photo">
            <ImagePlaceholder label={post.author.name} photo={post.author.photo} />
          </div>
          <div class="author-label">WRITTEN BY</div>
          <div class="author-name">{post.author.name}</div>
          {post.author.role && <div class="author-role">{post.author.role}</div>}
        </div>
        <div class="cta-card">
          <p class="cta-card-copy">Running into this on your own site? Send an engineer the specifics.</p>
          <Button href="/contact" variant="accent" class="cta-card-btn">Request a quote</Button>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <div data-reveal>
          <Kicker text="02 / KEEP READING" tone="light" />
          <h2 class="related-title">More from the field.</h2>
        </div>
        <div class="related-grid" data-reveal-group>
          {related.map((p) => (
            <InsightCard
              title={p.title}
              href={`/insights/${p.slug}`}
              photo={p.photo}
              category={p.category}
              date={formatInsightDate(p.date)}
              readTime={p.readTime}
              excerpt={p.excerpt}
              authorName={p.author.name}
              authorPhoto={p.author.photo}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .detail {
    border-bottom: 1px solid var(--border);
  }

  .crumbs {
    padding: 22px 32px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .crumbs a {
    color: var(--text-muted);
  }

  .crumb-current {
    color: var(--ink);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .detail-copy {
    padding: 56px 40px 48px;
  }

  .detail-title {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4.4vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .detail-intro {
    margin: 26px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--grid-line);
    border: 1px solid var(--grid-line);
    margin: 34px 0;
  }

  .fact {
    background: var(--bg);
    padding: 18px 20px;
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 7px;
  }

  .fact-value {
    font-size: 16px;
    font-weight: 600;
  }

  .detail-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .detail-visual {
    border-left: 1px solid var(--border);
    background: var(--surface);
    min-height: 420px;
  }

  .article {
    border-bottom: 1px solid var(--border);
    padding: 72px 0 84px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.9fr);
    gap: 72px;
    align-items: start;
  }

  .article-body {
    max-width: 640px;
  }

  .article-p {
    margin: 0 0 22px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-body);
  }

  .pull-quote {
    margin: 40px 0;
    padding-left: 28px;
    border-left: 2px solid var(--blue);
  }

  .pull-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .takeaways {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border-strong);
  }

  .takeaways-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .takeaways-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .takeaways-list li {
    position: relative;
    padding-left: 24px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body-2);
  }

  .takeaways-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--blue);
    font-family: var(--font-mono);
  }

  .article-aside {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--grid-line);
    border: 1px solid var(--grid-line);
    position: sticky;
    top: 96px;
  }

  .author-card,
  .cta-card {
    background: var(--bg);
    padding: 26px;
  }

  .author-photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .author-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .author-role {
    margin-top: 4px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .cta-card-copy {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-body-2);
  }

  :global(.cta-card-btn) {
    width: 100%;
  }

  .related {
    border-bottom: 1px solid var(--border);
    background: var(--bg-alt);
    padding: 72px 0 84px;
  }

  .related-title {
    margin: 24px 0 40px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 3.6vw, 40px);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--grid-line);
    border: 1px solid var(--grid-line);
  }

  @media (max-width: 900px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .detail-visual {
      border-left: none;
      border-top: 1px solid var(--border);
      min-height: 280px;
    }
    .article-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .article-aside {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .author-card,
    .cta-card {
      flex: 1 1 240px;
    }
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
