---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageMast from '../components/PageMast.astro';
import Kicker from '../components/Kicker.astro';
import TeamCard from '../components/TeamCard.astro';
import { TEAM, HEADCOUNT } from '../data/team.js';
---

<BaseLayout
  title="Team"
  description="Forty-five people across design, fabrication, installation, validation, and service — all on payroll."
>
  <PageMast
    kicker="01 / TEAM"
    title="Engineers you will actually meet."
    sub="Forty-five people across design, fabrication, installation, validation, and service. All on payroll — the person who drew it is on site when it is commissioned."
  />

  <section class="people">
    <div class="wrap">
      <div class="people-grid" data-reveal-group>
        {TEAM.map((m, i) => (
          <TeamCard no={String(i + 1).padStart(2, '0')} name={m.name} role={m.role} photo={m.photo} />
        ))}
      </div>
    </div>
  </section>

  <section class="headcount">
    <div class="wrap">
      <div data-reveal>
        <Kicker text="02 / HEADCOUNT" tone="dark" />
        <h2 class="headcount-title">Where the forty-five sit.</h2>
      </div>
      <div class="headcount-grid" data-reveal-group>
        {HEADCOUNT.map((h) => (
          <div class="headcount-item" data-reveal-item>
            <div class="headcount-number" data-count>{h.count}</div>
            <h3 class="headcount-name">{h.title}</h3>
            <p class="headcount-body">{h.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .people {
    border-bottom: 1px solid var(--border);
    padding: 56px 0 76px;
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--grid-line);
    border: 1px solid var(--grid-line);
  }

  .headcount {
    border-bottom: 1px solid var(--border);
    background: var(--ink);
    color: #fff;
    padding: 72px 0 84px;
  }

  .headcount-title {
    margin: 24px 0 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 44px);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .headcount-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2px;
  }

  .headcount-item {
    background: var(--panel);
    padding: 32px 26px;
  }

  .headcount-number {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 12px;
  }

  .headcount-name {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 600;
  }

  .headcount-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-slate-2);
  }

  @media (max-width: 900px) {
    .people-grid {
      grid-template-columns: 1fr 1fr;
    }
    .headcount-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .people-grid {
      grid-template-columns: 1fr;
    }
    .headcount-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
